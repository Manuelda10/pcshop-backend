# ============================================================
# Auth Service — Variables de Entorno (DESARROLLO LOCAL)
# NUNCA commitear este archivo
# ============================================================

# ---- App ----
APP_NAME=auth-service
APP_ENV=development
LOG_LEVEL=debug

# ---- HTTP ----
HTTP_PORT=8080
HTTP_READ_TIMEOUT_SEC=10
HTTP_WRITE_TIMEOUT_SEC=10

# ---- PostgreSQL ----
# Si usas docker-compose: DB_HOST=postgres (nombre del contenedor)
# Si corres el servicio fuera de docker: DB_HOST=localhost
DB_HOST=postgres
DB_PORT=5432
DB_USER=auth_user
DB_PASSWORD=auth_pass
DB_NAME=auth_db
DB_SSL_MODE=disable

# ---- JWT ----
# Generados con: openssl rand -hex 32
JWT_ACCESS_SECRET=aaaaa
JWT_REFRESH_SECRET=aaaaa
JWT_ACCESS_EXPIRY_MIN=15
JWT_REFRESH_EXPIRY_DAYS=7

# ---- Google OAuth2 ----
# Obtener en: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# ---- SMTP / Email ----
# Mailtrap para desarrollo: https://mailtrap.io (gratis, no envía emails reales)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=tu-mailtrap-user
SMTP_PASSWORD=tu-mailtrap-password
EMAIL_FROM_ADDRESS=no-reply@pc-store.com
EMAIL_FROM_NAME=PC Store